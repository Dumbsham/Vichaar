# Environment configuration for Vichaar
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
# Set only to the address or CIDR of a trusted reverse proxy when one is deployed.
TRUST_PROXY=
TRACKING_PORT=4001
TRACKING_BASE_URL=http://localhost:4001
TRACKING_HMAC_SECRET=local_development_tracking_secret_32chars_min!

# PostgreSQL
DATABASE_URL=postgres://vichaar:vichaar_pass@localhost:5432/vichaar
DATABASE_REPLICA_URL=postgres://vichaar:vichaar_pass@localhost:5433/vichaar

# Redis
REDIS_URL=redis://localhost:6379

# Queue (ElasticMQ in dev/test, SQS in production)
SQS_ENDPOINT=http://localhost:9324
SQS_QUEUE_BASE_URL=http://localhost:9324/queue
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=vichaar
CLICKHOUSE_USER=vichaar
CLICKHOUSE_PASSWORD=vichaar_local

# Mailpit (local SMTP)
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
EMAIL_PROVIDER=smtp
EMAIL_FROM=newsletter@vichaar.test
PUBLIC_BASE_URL=http://localhost:4000
# Production only: SES sandbox recipients must be explicitly verified.
SES_VERIFIED_ADDRESSES=

# One role per worker process: relay, fanout, scheduler, sender, sweeper, webhooks, reconciliation.
WORKER_ROLE=relay
METRICS_BASE_PORT=9100
# Optional collector base URL; workers send traces to /v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Secrets
SESSION_SECRET=local_development_session_secret_32chars_min!
TOKEN_HMAC_SECRET=local_development_hmac_secret_32chars_min!

# Razorpay (Test Mode only). Leave unset until test keys are available.
# Use a distinct webhook secret of at least 32 characters; configure the same value in the test-mode Razorpay dashboard.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
