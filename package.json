{
  "name": "vichaar-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "stack:up": "docker compose -f infra/compose/docker-compose.yml up -d",
    "stack:down": "docker compose -f infra/compose/docker-compose.yml down",
    "db:migrate": "pnpm --filter @vichaar/db migrate",
    "db:seed": "pnpm --filter @vichaar/db seed",
    "dev": "turbo dev --env-mode=loose",
    "build": "turbo build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:boundary-fixture": "vitest run tests/boundary-rule.test.ts",
    "lint": "eslint . && turbo typecheck",
    "format": "prettier --write .",
    "loadtest": "LOG_LEVEL=error tsx loadtests/send-500k.js && LOG_LEVEL=error tsx loadtests/slots.js",
    "chaos": "pnpm test chaos/"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.11.1",
    "@types/supertest": "^6.0.2",
    "@vichaar/queue": "workspace:*",
    "@vichaar/shared": "workspace:*",
    "eslint": "^9.15.0",
    "express": "^5.0.0",
    "prettier": "^3.3.3",
    "redis": "5",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^2.4.0",
      "fflate": "0.7.5"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
