{
  "name": "@vichaar/workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/dev.ts",
    "relay": "WORKER_ROLE=relay tsx src/index.ts",
    "fanout": "WORKER_ROLE=fanout tsx src/index.ts",
    "scheduler": "WORKER_ROLE=scheduler tsx src/index.ts",
    "sender": "WORKER_ROLE=sender tsx src/index.ts",
    "sweeper": "WORKER_ROLE=sweeper tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1158.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@vichaar/api": "workspace:*",
    "@vichaar/db": "workspace:*",
    "@vichaar/queue": "workspace:*",
    "@vichaar/shared": "workspace:*",
    "nodemailer": "^10.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
